// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "opencode": {
      "type": "registry"
    }
  },
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "ssh_connections": [
    {
      "host": "cortx-server",
      "username": "abe",
      "args": ["-i", "/Users/abe/.ssh/cortx-server"],
      "projects": [
        {
          "paths": ["/home/abe"],
        },
        {
          "paths": ["/home/opencode"],
        },
        {
          "paths": ["/srv/repos/"],
        },
        {
          "paths": ["/srv/repos/cortx-server"],
        },
        {
          "paths": ["/srv/repos/optimise-team-ops"],
        },
      ],
    },
  ],
  "diff_view_style": "unified",
  "sticky_scroll": {
    "enabled": true,
  },
  "git_panel": {
    "entry_primary_click_action": "file_diff",
    "button": true,
    "sort_by": "name",
    "group_by": "staging",
    "dock": "left",
    "tree_view": true,
    "collapse_untracked_diff": false,
  },
  "disable_ai": false,
  "buffer_font_family": ".ZedMono",
  "agent": {
    "dock": "right",
    "inline_assistant_model": {
      "provider": "OpenCode",
      "model": "minimax-m2.1",
    },
    "default_model": {
      "provider": "OpenCode",
      "model": "claude-haiku-4-5",
    },
    "model_parameters": [],
  },
  "language_models": {
    "openai_compatible": {},
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "VSCode Icons for Zed (Dark)",
  },
  "base_keymap": "VSCode",
  "ui_font_size": 14,
  "buffer_font_size": 11,
  "theme": {
    "mode": "system",
    "light": "Night Owl Light",
    "dark": "Night Owl Dark",
  },
}
