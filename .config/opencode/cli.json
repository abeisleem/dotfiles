{
  "theme": {
    "name": "tokyonight"
  },
  "keybinds": {
    "app.exit": "ctrl+q"
  },
  "scroll": {
    "acceleration": true
  },
  "attention": {
    "enabled": true,
    "sound": false
  },
  "diffs": {
    "wrap": "word",
    "tree": true,
    "single": false,
    "view": "unified"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "auto",
    "image_preview": false,
    "new_location": "launch"
  },
  "animations": true,
  "tabs": {
    "scope": "cwd",
    "vertical": false,
    "enabled": true,
    "layout": "vertical"
  },
  "prompt": {
    "paste": "full",
    "image_preview": false
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "debug": {
    "devtools": false,
    "turn_tokens": false
  }
}
