{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": ["opencode-quick-quote", "opencode-quick-links", "opencode-switchboard"],
  "theme": {
    "name": "tokyonight"
  },
  "keybinds": {
    "app.exit": "ctrl+q"
  },
  "scroll": {
    "acceleration": true
  },
  "attention": {
    "sound": true,
    "notifications": true,
    "volume": 0.4
  },
  "diffs": {
    "wrap": "word",
    "tree": true,
    "single": false,
    "view": "unified"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "auto",
    "image_preview": true,
    "new_location": "inherit",
    "tps": true,
    "verbosity": "low",
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "scope": "global",
    "enabled": true,
    "layout": "vertical",
    "indicators": "status",
    "mode": "off"
  },
  "prompt": {
    "paste": "full",
    "image_preview": true
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "debug": {
    "devtools": false,
    "turn_tokens": false
  },
  "highlights": true
}
