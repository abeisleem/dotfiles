{
  "theme": {
    "name": "tokyonight"
  },
  "keybinds": {
    "app_exit": "ctrl+q"
  },
  "scroll": {
    "acceleration": true
  },
  "attention": {
    "enabled": false
  },
  "diffs": {
    "wrap": "word",
    "tree": true,
    "single": false,
    "view": "unified"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "auto"
  },
  "animations": true,
  "tabs": {
    "scope": "cwd",
    "vertical": false,
    "enabled": false
  },
  "prompt": {
    "paste": "full"
  },
  "terminal": {
    "copy_on_select": true
  }
}
