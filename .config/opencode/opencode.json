{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "autoupdate": true,
  "default_agent": "anti-glaze",
  "agents": {
    "anti-glaze": {
      "color": "#2f07d9"
    },
    "title": {
      "model": "opencode/deepseek-v4-flash-free"
    },
    "summary": {
      "model": "opencode/deepseek-v4-flash-free"
    },
    "compaction": {
      "model": "opencode/deepseek-v4-flash-free"
    }
  },
  "experimental": {
    "disable_paste_summary": true
  },
  "permissions": [
    { "action": "external_directory", "resource": "~/.agents/skills/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "**/.ssh/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/mcp-auth.json", "effect": "deny" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.envrc", "effect": "deny" },
    { "action": "read", "resource": "**/.env", "effect": "deny" },
    { "action": "read", "resource": "**/.env.*", "effect": "deny" },
    { "action": "read", "resource": "**/.envrc", "effect": "deny" },
    { "action": "read", "resource": ".dev.vars", "effect": "deny" },
    { "action": "read", "resource": "**/.dev.vars", "effect": "deny" },
    { "action": "read", "resource": "secrets/*", "effect": "deny" },
    { "action": "read", "resource": "**/secrets/**", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "**/.aws/**", "effect": "deny" },
    { "action": "read", "resource": "**/.ssh/**", "effect": "deny" },
    { "action": "read", "resource": "~/.local/share/opencode/mcp-auth.json", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "printenv *", "effect": "deny" },
    { "action": "shell", "resource": "env", "effect": "deny" },
    { "action": "shell", "resource": "env *", "effect": "deny" },
    { "action": "shell", "resource": "export *", "effect": "deny" },
    { "action": "shell", "resource": "gh auth *", "effect": "deny" },
    { "action": "shell", "resource": "cat *.env", "effect": "deny" },
    { "action": "shell", "resource": "cat *.env.*", "effect": "deny" },
    { "action": "shell", "resource": "cat **/.env", "effect": "deny" },
    { "action": "shell", "resource": "cat **/.env.*", "effect": "deny" },
    { "action": "shell", "resource": "cat *.envrc", "effect": "deny" },
    { "action": "shell", "resource": "cat **/.envrc", "effect": "deny" },
    { "action": "shell", "resource": "cat .dev.vars", "effect": "deny" },
    { "action": "shell", "resource": "cat **/.dev.vars", "effect": "deny" },
    { "action": "shell", "resource": "cat *.pem", "effect": "deny" },
    { "action": "shell", "resource": "cat *.key", "effect": "deny" },
    { "action": "shell", "resource": "cat **/.aws/**", "effect": "deny" },
    { "action": "shell", "resource": "cat **/.ssh/**", "effect": "deny" },
    { "action": "shell", "resource": "rm *", "effect": "deny" },
    { "action": "shell", "resource": "git push", "effect": "ask" },
    { "action": "shell", "resource": "brew install", "effect": "ask" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "list", "resource": "*", "effect": "allow" },
    { "action": "lsp", "resource": "*", "effect": "allow" },
    { "action": "todoread", "resource": "*", "effect": "allow" },
    { "action": "todowrite", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "codesearch", "resource": "*", "effect": "allow" },
    { "action": "doom_loop", "resource": "*", "effect": "ask" }
  ],
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
        "disabled": true
      },
      "shadcn": {
        "type": "local",
        "command": ["npx", "shadcn@latest", "mcp"],
        "disabled": true
      },
      "supabase": {
        "type": "remote",
        "url": "http://localhost:54321/mcp",
        "disabled": true
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      },
      "executor": {
        "type": "remote",
        "url": "http://localhost:4789/mcp",
        "disabled": false,
        "headers": {
          "Authorization": "Bearer {env:EXECUTOR_TOKEN}"
        }
      }
    }
  }
}
