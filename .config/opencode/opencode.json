{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "opencode/big-pickle",
  "model": "opencode/kimi-k2.5-free",
  "autoupdate": true,
  "agent": {
    "explore": {
      "disable": false,
      "permission": {
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "question": "allow",
        "webfetch": "ask",
        "websearch": "ask",
        "todowrite": "allow",
        "todoread": "allow"
      }
    }
  },
  "permission": {
    "webfetch": "ask",
    "websearch": "ask"
  },
  "plugin": ["@mohak34/opencode-notifier@latest"],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "cloudflare-api": {
      "type": "remote",
      "enabled": false,
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "supabase": {
      "type": "remote",
      "url": "http://localhost:54321/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  }
}
