{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "~/.cache/opencode/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/opencode/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.local/share/opencode/log/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/repos/**",
      "effect": "allow"
    }
  ]
}
